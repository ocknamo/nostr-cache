{
  "name": "@nostr-cache/shared",
  "version": "0.1.0",
  "description": "Shared types and utilities for Nostr cache project",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocknamo/nostr-cache.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/ocknamo/nostr-cache/tree/main/packages/shared#readme",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "node -e \"for(const p of ['dist','tsconfig.tsbuildinfo'])fs.rmSync(p,{recursive:true,force:true})\" && tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "biome format --write ./src && biome check --write ./src",
    "format:check": "biome check ./src",
    "lint": "biome check ./src",
    "lint:check": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "fix": "npm run lint:fix && npm run format",
    "fix:unsafe": "biome check --fix --unsafe",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "^6.0.0",
    "vitest": "5.0.3"
  }
}
